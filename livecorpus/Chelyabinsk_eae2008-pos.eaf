                <ANNOTATION_VALUE>или например / это было актуально когда</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1266"
                TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts54">
