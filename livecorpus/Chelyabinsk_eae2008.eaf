    <TIER ANNOTATOR="@dvb2005m" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="utterance" PARTICIPANT="@dvb2005m" TIER_ID="text@dvb2005m">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts21" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>ну в целом согласен</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18"
                TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts26">
                <ANNOTATION_VALUE>в= вот помимо бы вот / финс= финского норвежского ты ч= учила ещё какие нибудь языки возможно вне / ээ учебного времени то есть / которые не входили в / твою / это / в твою языковую программу в школе / но при этом те просто было интересно допустим вот ты просто увидела язык и такая я хочу его изучать</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19"
                TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>я также слышал ты про китайский рассказывала</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
